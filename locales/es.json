      "sourceSha256": "e7c24fff5ec6b890aadb1829e76de655c6562e167dc962aacd0fa26f14835207"
    },
    "inner-course.index.text.0060": {
      "value": "La brújula",
      "sourceSha256": "2eebb7accc2fc83e8e79cf9ba16a3d9d9bbca85fc85e49a07546cb5a7c7b9b08"
    },
    "inner-course.index.text.0061": {
      "value": "Ayuda",
      "sourceSha256": "be91940b79f469101df9a50544b6873aa5509a12f1f93f1cb5e3be3990d344b3"
    },
    "inner-course.index.text.0062": {
      "value": "Todas las apps",
      "sourceSha256": "01bed311e7d0c963a5f8afe3dd3c99c8140d887d92c602b94b9309fa51b32723"
    },
    "inner-course.index.text.0063": {
      "value": "© 2026 Inner Course por Moving Truth. Creado para iPhone.",
      "sourceSha256": "f83db333672ea0bb36be0daec00c5309e3c5fddcfc77d22518260ad4f5136d40"
    },
    "inner-course.index.attribute.0001": {
      "value": "Inner Course es una app de lecciones y reflexión creada con cuidado por Moving Truth. No es contenido infinito. No está convertida en un juego. Es una compañía para el viaje interior. Próximamente para iPhone.",
