{
  "schema": "release-fabric/catalog@2",
  "messages": {
    "inner-course.index.text.0001": {
      "value": "Inner Course — por Moving Truth",
      "sourceSha256": "aaffae20edcb64575f264ef98942949f623fb6f935174453f11c08285cd94d4d"
    },
    "inner-course.index.text.0002": {
      "value": "Ir al contenido principal",
      "sourceSha256": "c887f134c26ea8310e1fb4bd6fbab7b640393bd1b556e62691c7a442be92ec2a"
    },
    "inner-course.index.text.0003": {
      "value": "Abrir navegación",
      "sourceSha256": "0ed77fd2619ba8ab3e1cce72c8e61d887d551ca1220164b88ab1aa66bba7177d"
    },
    "inner-course.index.text.0004": {
      "value": "Por qué existe",
      "sourceSha256": "77890c5d4168a3af5e9a2611921690bb9f2f6c2a02e7269ab9b268f2f1bbed00"
    },
    "inner-course.index.text.0005": {
      "value": "El camino de la lección",
      "sourceSha256": "da6d93bc13f9fda60d825bb4558494f64077f4253a5cc3338778fb02e71775b4"
    },
    "inner-course.index.text.0006": {
      "value": "La brújula",
      "sourceSha256": "2eebb7accc2fc83e8e79cf9ba16a3d9d9bbca85fc85e49a07546cb5a7c7b9b08"
    },
    "inner-course.index.text.0007": {
      "value": "Disponibilidad",
      "sourceSha256": "12f67f8539c46701e62d1c50254cf025c22a992b06fea6d4c0e19705f21f4cac"
    },
    "inner-course.index.text.0008": {
      "value": "Todas las apps",
      "sourceSha256": "01bed311e7d0c963a5f8afe3dd3c99c8140d887d92c602b94b9309fa51b32723"
    },
    "inner-course.index.text.0009": {
      "value": "Donde Moving Truth se mueve hacia fuera, Inner Course se adentra.",
      "sourceSha256": "906b8ec1efda5796a7a50b1e81913790a0c09607855b2e15acc5f333af935f58"
    },
    "inner-course.index.text.0010": {
      "value": "Próximamente para iPhone",
      "sourceSha256": "4f94b16d081a4fcdffecf1eb355a8fddac4bcf388b396e40fd9c80d7e029aec9"
    },
    "inner-course.index.text.0011": {
      "value": "Abrir la primera página",
      "sourceSha256": "2657fa7e7b3972034ebdd128913634d6c5b7ab03b824489454cacd94147d63f7"
    },
    "inner-course.index.text.0012": {
      "value": "desplázate para comenzar",
      "sourceSha256": "39ba6e3aa27d93b7ae50335ef0e18702befc3f75bb31b846e339ed8aa353cdb7"
    },
    "inner-course.index.text.0013": {
      "value": "No es contenido infinito. No es una colección de citas. Es una compañía.",
      "sourceSha256": "e00398f164e6ae84897ee9cf07c9d917f4e2c4cef0d0eb57482635b1b0664354"
    },
    "inner-course.index.text.0014": {
      "value": "Inner Course existe para crear momentos en los que una persona se detenga el tiempo suficiente para pensar. Sus lecciones no corren hacia las respuestas. Invitan a reflexionar, escribir, guardar silencio y volver; a encontrar una comprensión capaz de convertirse en acción compasiva.",
      "sourceSha256": "97e9fb6df29f38efc30ee799374d98c0d482e114844aad349f39022ec80e8aaf"
    },
    "inner-course.index.text.0015": {
      "value": "El progreso se mide en reflexión, no en tareas terminadas.",
      "sourceSha256": "81404ef338ce8d531f823498fd838b5e8eadb70868f6d9b37ae57ec8d0916c03"
    },
    "inner-course.index.text.0016": {
      "value": "Cada lección tiene su ritmo",
      "sourceSha256": "7b63029792374df8603ed18bf3c43cad02fb53ce09f406d92a5472ef158362ed"
    },
    "inner-course.index.text.0017": {
      "value": "Una estructura que abre espacio para el sentido.",
      "sourceSha256": "922612bd2f7439245e5b575cc0d73020768a98e8895a385a7bd75423e0c47e94"
    },
    "inner-course.index.text.0018": {
      "value": "Cada lección sigue el mismo camino consciente. Puede terminar con una pregunta. Puede terminar en quietud. Nada obliga a quien lee a seguir antes de estar preparado.",
      "sourceSha256": "cbddeafd4804e7673e302f9238ecc25fad5ad09d0718ec6d3f1b41936bdccd4a"
    },
    "inner-course.index.text.0019": {
      "value": "Invitación",
      "sourceSha256": "af4ea02852eb08ea7b96b093b59e744da12779a5997fd70804d7068c90a7cda0"
    },
    "inner-course.index.text.0020": {
      "value": "Exploración",
      "sourceSha256": "f08e7f4a8d5c7b2a62ede2d1643527c2e823bd454f9e8c632d4f55db0f3a3cc0"
    },
    "inner-course.index.text.0021": {
      "value": "Reflexión",
      "sourceSha256": "7538c2135b030e4e91c01e4952055324c62e0182b94d2d0bf0c272f7f55e2373"
    },
    "inner-course.index.text.0022": {
      "value": "Integración",
      "sourceSha256": "9a42d40a3f319da59ce05d08f77f348f7a4ae965ff3e8251334adf67432b011d"
    },
    "inner-course.index.text.0023": {
      "value": "Quietud",
      "sourceSha256": "88939fa793a3e79692da14bb58d45ae01993bc394d1fccca1c97efe017cbec96"
    },
    "inner-course.index.text.0024": {
      "value": "La brújula del diseño",
      "sourceSha256": "3cbadd7d145b87324190ca2c697bb418f189a5cb8b3062821be3327e29fb4fd6"
    },
    "inner-course.index.text.0025": {
      "value": "¿Esto es más verdadero?",
      "sourceSha256": "88d8f817f9d76f60275344c3b090602fd3508860cc4b6203371cb45862062758"
    },
    "inner-course.index.text.0026": {
      "value": "No: ¿es más emocionante, más moderno o más impresionante? Cada decisión incierta en Inner Course vuelve a una pregunta. La verdad se convierte en la brújula. Estructura, no ruido.",
      "sourceSha256": "08ad96523724cad14ce1d684e76962eaa8b44b8a56f7b5a36a48a79ca87c5235"
    },
    "inner-course.index.text.0027": {
      "value": "Reflexión antes que reacción",
      "sourceSha256": "8d3c536f6964778ca173faf8e8533510e5c666ab76ea29f8e31da1000cf57cd4"
    },
    "inner-course.index.text.0028": {
      "value": "La obra valora lo que se observa y se escribe, no la rapidez con la que se consume una lección.",
      "sourceSha256": "b964d96c4835f167bfd09633fe174e45f98bc3c369521cf5f99fa431ac51ad5b"
    },
    "inner-course.index.text.0029": {
      "value": "Volver, no terminar",
      "sourceSha256": "4d7cd37661f1edb376d0a093f93d53c0cc6b064fc1a158306c66ce41303832c1"
    },
    "inner-course.index.text.0030": {
      "value": "Un marcapáginas discreto recuerda que el camino seguirá abierto cuando estés preparado.",
      "sourceSha256": "6d14906e9afb1e1c343cd07211a108d7cb91203033f3adfabc3447a164247355"
    },
    "inner-course.index.text.0031": {
      "value": "Oficio, no espectáculo",
      "sourceSha256": "85be589e13c4a025e60d4598288fd1fb97555b22e881cbbaf65720c153a5aff6"
    },
    "inner-course.index.text.0032": {
      "value": "Movimiento con propósito, calidez táctil y contención en lugar de efectos que reclaman atención.",
      "sourceSha256": "f3df51cd6dbe87861dc1c2e19c19102dff3b0f346ae5af505edaa674603fb800"
    },
    "inner-course.index.text.0033": {
      "value": "Preguntas, no fórmulas",
      "sourceSha256": "51579c0eb281f418dc860954137fcb81cc0260028393bbd8331a07a5400fbee1"
    },
    "inner-course.index.text.0034": {
      "value": "Las lecciones ayudan a formular mejores preguntas sin fingir que contienen todas las respuestas.",
      "sourceSha256": "b6799d4b294b0dbaed09ff60a9e778a5773f23be85a4c9b969783e34a41ed35a"
    },
    "inner-course.index.text.0035": {
      "value": "El libro",
      "sourceSha256": "77219ddbe6dad86e320e27258caababa717cf63581374235444b5b8f4621c09e"
    },
    "inner-course.index.text.0036": {
      "value": "No es nuevo. No está descuidado. Es querido.",
      "sourceSha256": "c22ab2af1080adab2493fa5ddde5dcd034af2fd747afbb7a5f43639608e144ca"
    },
    "inner-course.index.text.0037": {
      "value": "El libro encuadernado en cuero es más que un icono. Es la cubierta del primer libro que abre cada persona: con las esquinas suavizadas, marcado por cada regreso y esperando sin prisa. La primera pantalla debe sentirse como pasar su primera página.",
      "sourceSha256": "9707e04ae184ae9e8874aec41a9e8010bc43174df07acf3f3f688414547ad61b"
    },
    "inner-course.index.text.0038": {
      "value": "El marcapáginas permanece. Alguien ya ha recorrido este camino. Puedes continuar.",
      "sourceSha256": "2f03a50e83d7817289c2a1b215594b5f74464fa36592ec62733432f0ec99a299"
    },
    "inner-course.index.text.0039": {
      "value": "Catorce puertas",
      "sourceSha256": "df8c86d5da501d8b8e804d39c84bd987989f40c2f4e180db58f9717f4b42dcc8"
    },
    "inner-course.index.text.0040": {
      "value": "Cada lección se abre a través de catorce puertas.",
      "sourceSha256": "9877cd475d00fda1948d8177e68fb398b6104064def80646e7088c0f6413dccc"
    },
    "inner-course.index.text.0041": {
      "value": "Dentro de la app, cada lección se crea desde el principio en inglés, francés, español, alemán, portugués de Brasil, italiano, neerlandés, hindi, árabe, chino simplificado, japonés, coreano, ruso y tailandés; no se añade después de terminar la experiencia en inglés.",
      "sourceSha256": "0762d82cdb97ae7c7b445ac3ac421b50e73c215537ed115a73d32301ddf2adad"
    },
    "inner-course.index.text.0042": {
      "value": "Traducir la lección, no solo sus palabras.",
      "sourceSha256": "04d826b3ae6dd78844f884096498450dbfa2508602189fed97adb0c816858723"
    },
    "inner-course.index.text.0043": {
      "value": "Respetar la lectura de derecha a izquierda y las distintas formas en que cada lengua sostiene el significado.",
      "sourceSha256": "0f72c8902c2a9e3fa79f3f6e8ef3ae7247d9896ee49f01ea7412ffe93885ba9c"
    },
    "inner-course.index.text.0044": {
      "value": "Crear un camino común y accesible, sin ofrecer una experiencia separada y menor.",
      "sourceSha256": "c25750ff2d336d690b5ad83e745de1fcff025add4a44b9cdf05be06e1066e4b3"
    },
    "inner-course.index.text.0045": {
      "value": "Conservar la serenidad y la dignidad en cada traducción.",
      "sourceSha256": "40d9063fee6494c3238390838ab8436810c235b693c78d4f91a78edc9f914da0"
    },
    "inner-course.index.text.0046": {
      "value": "Una bendición para Inner Course",
      "sourceSha256": "439b2626cb6b6cd67a6597c4b2f69716231bb142845d07518a2f40fc71433a31"
    },
    "inner-course.index.text.0047": {
      "value": "Que cada decisión se tome con cuidado.",
      "sourceSha256": "8340a9cd794d87491dc97d185a766c6a09f7581426ea00e39ce4a47d3d3c68cc"
    },
    "inner-course.index.text.0048": {
      "value": "Que cada lección invite a una reflexión honesta.",
      "sourceSha256": "a8497526f29a7b7b5c1ef5f57a6f9ce64df4cfb4ddc2f92a63be4a0c05869b50"
    },
    "inner-course.index.text.0049": {
      "value": "Que cada reflexión se convierta en acción compasiva.",
      "sourceSha256": "eb63a4324041b5586afccec3f5250b5863c5b634f0c49d11217a0992d9682069"
    },
    "inner-course.index.text.0050": {
      "value": "La verdad mueve. La sabiduría perdura. La compasión se multiplica.",
      "sourceSha256": "bc192b5dadd246485a9b48a89161da5d8297a3a6f4fb5dd68f732b35009e6443"
    },
    "inner-course.index.text.0051": {
      "value": "por Moving Truth",
      "sourceSha256": "3daa3456fa0b55162e7c72b8d69a3fff181d034edf3423bcf3ce5a972cf2aab4"
    },
    "inner-course.index.text.0052": {
      "value": "Creado con amor por Skylaur Roe",
      "sourceSha256": "8973d1d4a4d34a688cb6e6d9080ec19b076e65b44fac74776e850e1cfb0f6562"
    },
    "inner-course.index.text.0053": {
      "value": "Explorar todas las apps Moving Truth",
      "sourceSha256": "1a8f383841d7faff0dd5d4232e122c1fc9c9cd70a6081e1df6caffd492edc277"
    },
    "inner-course.index.text.0054": {
      "value": "Próximamente",
      "sourceSha256": "4f7d64017689437e6d93f5724f3f797054f3935d98a13148025b616b8db8fb2c"
    },
    "inner-course.index.text.0055": {
      "value": "El libro permanece cerrado hasta que alguien esté preparado para abrirlo.",
      "sourceSha256": "e2d9535ae7e797ccc9790cf880d5222ac717c920f364f6ad1879bf28695345af"
    },
    "inner-course.index.text.0056": {
      "value": "Inner Course se está creando para iPhone como un viaje de aprendizaje, reflexión y transformación que dura toda la vida. Despacio. Con paciencia. Sin apresurar a quien lee.",
      "sourceSha256": "f33bfa28bc4374f7407803b0258a086e14795a9212e6b8f5666f3cda7a99e3db"
    },
    "inner-course.index.text.0057": {
      "value": "Preguntar por Inner Course",
      "sourceSha256": "678837dade22071aa47e0416f8c1a4be55c2ca41ac711928d5de914feadd8b92"
    },
    "inner-course.index.text.0058": {
      "value": "Por qué existe",
      "sourceSha256": "77890c5d4168a3af5e9a2611921690bb9f2f6c2a02e7269ab9b268f2f1bbed00"
    },
    "inner-course.index.text.0059": {
